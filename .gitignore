# Quarto build output (website project emits all docs here)
_site/

# Per-document rendered artifacts (knitr intermediary + in-place HTML/files from
# the pre-website `type: default` project; not published, safe to remove)
*.knit.md
*.html
*_files/
# ...but keep the authored include-after-body snippets under resources/, which
# are source files (registered in _quarto.yml), not build artifacts.
!resources/slidecrafting/*.html

# R / renv
.Rhistory
.RData
renv/library/

/.quarto/
**/*.quarto_ipynb
.Rproj.user
.httr-oauth
.DS_Store
.quarto

/.luarc.json
